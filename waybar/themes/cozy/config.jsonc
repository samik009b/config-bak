{
  "position": "top",
  "modules-left": [
    "custom/logo",
    "hyprland/workspaces",
    "user",
    "custom/web",
    "custom/file",
    "custom/terminal",
    "custom/obsidian"
  ],
  "modules-center": [
    "clock",
    "bluetooth",
    "custom/wifi"
  ],
  "modules-right": [
    "backlight",
    "pulseaudio",
    "memory",
    "temperature",
    "battery",
    "custom/power"
  ],
  "user": {
    "format": "· {user}  󰞌 {work_H}:{work_M} ·",
    "interval": 60,
    "icon": true,
    "avatar": "/home/alice/.face",
    "height": 24,
    "width": 24,
    "open-on-click": true
  },
  "custom/obsidian": {
    "format": "",
    "on-click": "obsidian"
  },
  "custom/logo": {
    "format": " 🍁 ",
    "tooltip-format": "samikb"
  },
  "custom/wifi": {
    "exec": "~/.config/waybar/scripts/wifi-status.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{icon} {text}",
    "format-icons": {
      "enabled": "󰖩",
      "disabled": "󰖪"
    },
    "on-click": "nmcli radio wifi | grep -q enabled && nmcli radio wifi off || nmcli radio wifi on"
  },
  "custom/web": {
    "format": "󰖟",
    "tooltip": false,
    "on-click": "brave-browser",
    "on-click-right": "vivaldi-stable"
  },
  "custom/file": {
    "format": "󰉋",
    "tooltip": true,
    "on-click": "thunar",
    "on-click-right": "kitty -e ranger"
  },
  "custom/terminal": {
    "format": "",
    "tooltip": true,
    "on-click": "kitty",
    "on-click-right": "kitty -e ranger"
  },
  "hyprland/workspaces": {
    "persistent-workspaces": {
      "*": 5
    }
  },
  "backlight": {
    "format": "󰃝 {percent}% ·"
  },
  "clock": {
    "format": "{:%a, %d %b %Y 󰥔 %H:%M} ·",
    "tooltip": true,
    "tooltip-format": "{:%a, %d %B %Y}",
    "on-click": "gnome-pomodoro",
    "interval": 60
  },
  "pulseaudio": {
    "format": "{icon} {volume}% ·",
    "format-muted": "󰝟 muted ·",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "tooltip": true,
    "max-volume": 150
  },
  "bluetooth": {
    "format": "󰂯 ·",
    "format-on": "󰂯 On ·",
    "format-disabled": "󰂲 Off ·",
    "format-connected": "󰂱 {device_alias} ·",
    "on-click": "blueman-manager"
  },
  "memory": {
    "interval": 2,
    "format": "Mem: {percentage}% ·"
  },
  "custom/power": {
    "format": " ",
    "on-click": "wlogout"
  },
  "temperature": {
    "format": " {temperatureC}°C ·",
    "on-click": "gnome-system-monitor"
  },
  "battery": {
    "states": {
      "warning": 40,
      "danger": 25
    },
    "interval": 1,
    "on-click": "gnome-system-monitor",
    "format": "{icon} {capacity}% ·",
    "format-charging": "{icon} {capacity}% ·",
    "format-icons": {
      "default": [
        "󱊡",
        "󱊢",
        "󱊣"
      ],
      "charging": [
        "󰚥"
      ]
    }
  }
}
// Symbol	Meaning
// 	Terminal window
// 	Kitty terminal
// 	Terminal prompt
