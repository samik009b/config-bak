{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/temp.txt",
    "padding": {
      "right": 2,
      "bottom": 1
    },
    "color": {
      "1": "cyan"
    }
  },
  "display": {
    "separator": "| ",
    "size": {
      "binaryPrefix": "si"
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "os  ",
      "keyColor": "red",
      "format": "Debian GNU 13"
    },
    {
      "type": "uptime",
      "key": "up  ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "sh  ",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": "wm  ",
      "keyColor": "cyan",
      "format": "{2}"
    },
    {
      "type": "packages",
      "key": "pkg ",
      "keyColor": "blue",
      "format": "{dpkg}"
    },
    {
      "type": "memory",
      "key": "mem ",
      "keyColor": "magenta",
      "format": "{1} ({3})"
    },
    {
      "type": "colors",
      "key": "col ",
      "symbol": "circle"
    }
  ]
}