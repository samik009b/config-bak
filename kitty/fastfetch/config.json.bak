{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "width": 15,
    "height": 30,
    "padding": {
      "top": 1,
      "right": 1
    },
    "color": {
      "1": "magenta",
      "2": "cyan"
    }
  },

  "display": {
    "separator": " 󰁔 ",
    "color": {
      "keys": "cyan",
      "separator": "bright_black"
    },
    "size": {
      "binaryPrefix": "si"
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "\u001b[1;38;2;203;166;247m{user-name}\u001b[0m@\u001b[1;38;2;137;180;250m{host-name}\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;108;112;134m╭──────────────────────────────────────────────────────╮\u001b[0m"
    },
    {
      "type": "os",
      "key": " 󰣇  OS         "
    },
    {
      "type": "host",
      "key": " 󰌢  Host       "
    },
    {
      "type": "kernel",
      "key": "   Kernel     "
    },
    {
      "type": "packages",
      "key": " 󰏖  Packages   "
    },
    {
      "type": "shell",
      "key": " 󰆍  Shell      "
    },
    {
      "type": "terminal",
      "key": " 󰞷  Terminal   "
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;108;112;134m├──────────────────────────────────────────────────────┤\u001b[0m"
    },
    {
      "type": "de",
      "key": " 󰧨  Desktop    "
    },
    {
      "type": "wm",
      "key": " 󰖯  Window Mgr "
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;108;112;134m├──────────────────────────────────────────────────────┤\u001b[0m"
    },
    {
      "type": "cpu",
      "key": " 󰻠  CPU        "
    },
    {
      "type": "gpu",
      "key": " 󰢮  GPU        "
    },
    {
      "type": "memory",
      "key": " 󰍛  Memory     "
    },
    {
      "type": "localip",
      "key": " 󰩟  Local IP   "
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;108;112;134m├──────────────────────────────────────────────────────┤\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;245;194;231m  ● \u001b[38;2;243;139;168m● \u001b[38;2;250;179;135m● \u001b[38;2;249;226;175m● \u001b[38;2;166;227;161m● \u001b[38;2;137;220;235m● \u001b[38;2;137;180;250m● \u001b[38;2;203;166;247m●\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;108;112;134m╰──────────────────────────────────────────────────────╯\u001b[0m"
    }
  ]
}
