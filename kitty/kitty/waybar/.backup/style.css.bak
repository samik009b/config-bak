
/* ── Global ── */

* {
    font-family: "Fira Code", "Noto Sans", sans-serif;
    font-size: 15px;
    font-weight: 500;
    border: none;
    border-radius: 0;
    min-height: 0;
    box-shadow: none;
}

window#waybar {
    background: transparent;
    color: #cdd6f4;
}

/* ── Shared section backgrounds ── */

.modules-center,
.modules-right {
    background: rgba(30, 30, 46, 0.88);
    border: 1px solid rgba(69, 71, 90, 0.75);
    border-radius: 12px;
    padding: 3px 6px;
}

/* ── Individual modules ── */

#workspaces,
#window,
#clock,
#backlight,
#memory,
#temperature,
#battery,
#bluetooth,
#custom-power,
#tray {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0 7px;
    margin: 0;
    color: #cdd6f4;
    font-weight: 500;
}

/* ── Workspaces ── */

#workspaces {
    padding: 0 2px;
}

#workspaces button:active {
  background: rgba(81, 81, 116, 0.88);
}

#workspaces button {
    background: transparent;
    color: #6c7086;
    border-radius: 7px;
    padding: 0 8px;
    margin: 1px 2px;
}

#workspaces button:hover {
    background: #45475a;
    color: #cdd6f4;
}

#workspaces button.active {
    background: #cba6f7;
    color: #1e1e2e;
    font-weight: 700;
}

#workspaces button.urgent {
    background: #f38ba8;
    color: #1e1e2e;
}

/* ── Window title ── */

#window {
    color: #a6adc8;
}

/* ── Wi-Fi ── */


/* ── Bluetooth ── */

#bluetooth {
    color: #89b4fa;
}

/* ── System monitoring ── */

#memory {
    color: #cba6f7;
}

#temperature {
    color: #94e2d5;
}

#temperature.critical {
    color: #f38ba8;
}

/* ── Brightness ── */

#backlight {
    color: #f9e2af;
}

/* ── Battery ── */

#battery {
    color: #a6e3a1;
}

#battery.warning {
    color: #f9e2af;
}

#battery.critical {
    color: #f38ba8;
}

#battery.charging {
    color: #94e2d5;
}

/* ── Clock ── */

#clock {
    color: #cdd6f4;
    font-weight: 600;
}

/* ── Power ── */

#custom-power {
    color: #f38ba8;
    padding: 0 10px;
}

/* ── Tray ── */

#tray {
    padding: 0 5px;
}

/* ── Tooltips ── */

tooltip {
    background: #1e1e2e;
    border: 1px solid #cba6f7;
    border-radius: 8px;
}

tooltip label {
    color: #cdd6f4;
    font-size: 13px;
}
